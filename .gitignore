!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output ───────────────────────────────────────────
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo
.vite/

# ─── Environment variables (never commit secrets) ──────────
.env
.env.*
!.env.example

# ─── Testing & coverage ─────────────────────────────────────
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Caches ─────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

# ─── Editors & IDEs ─────────────────────────────────────────
