# ─── Dependencies ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output ───────────────────────────────────────────
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo
.vite/
.next/
next-env.d.ts.timestamp

# ─── Environment variables (never commit secrets) ──────────
.env
.env.*
!.env.example

# ─── Testing & coverage ─────────────────────────────────────
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Caches ─────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

# ─── Editors & IDEs ─────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# SentinelScout (FL-07): advisory cache, and per-run drafts. Only the latest brief is committed.
.sentinel-cache/
docs/drafts/*
!docs/drafts/latest-triage-brief.md

# Playwright output (FE-09)
/test-results/
/playwright-report/
