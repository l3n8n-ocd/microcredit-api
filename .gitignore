!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
