  "description": "Alternative Credit Scoring & Micro-Lending Portal",
  "license": "MIT",
  "author": "Lenon D. Adriano",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
