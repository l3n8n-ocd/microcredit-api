    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.91.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
