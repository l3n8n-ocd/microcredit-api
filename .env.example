# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# ⚠️ Any VITE_* variable is bundled into the client and visible to every user.
#    Never put secrets in a VITE_* variable (CLAUDE.md §8).

# ─── Client (public) ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_WALLET_PROVIDER_MODE=mock

# ─── Server only (never prefix with VITE_) ─────────────────
GCASH_MOCK_API_KEY=
MAYA_MOCK_API_KEY=
WALLET_WEBHOOK_SIGNING_SECRET=
