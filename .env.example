# MicroCredit API — environment variable structure.
# Copy to .env.local for development. NEVER commit real secrets (CLAUDE.md §8).
# Only NEXT_PUBLIC_* values are bundled into client code; everything else is server-only.

# Public (safe to expose to the browser)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — used by the planned AI underwriting route (FE-06/FE-07). Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-placeholder-do-not-commit-real-key

# Server-only — wallet webhook HMAC verification (planned).
WEBHOOK_HMAC_SECRET=whsec_placeholder_only
