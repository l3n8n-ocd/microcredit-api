# MicroCredit API — environment variable structure.
# Copy to .env.local for development. NEVER commit real secrets (CLAUDE.md §8).
# Only NEXT_PUBLIC_* values are bundled into client code; everything else is server-only.

# Public (safe to expose to the browser)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Underwriting Copilot (FE-06), POST /api/chat ─────────────────────────
# All OPTIONAL and all SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_.
# They are read in exactly one file: src/lib/ai/underwriting-model.ts.
#
# With no key set (or with these placeholders left as they are), /api/chat
# streams from the local rule engine, so the chat works on a fresh clone.
# Engine order when keys are set: Anthropic first, then Google.
ANTHROPIC_API_KEY=sk-ant-placeholder-do-not-commit-real-key
GOOGLE_GENERATIVE_AI_API_KEY=placeholder-do-not-commit-real-key

# Optional model overrides (not secrets). Defaults: claude-opus-5-5, gemini-flash-latest.
# ANTHROPIC_MODEL=claude-haiku-5-5
# GOOGLE_GENERATIVE_AI_MODEL=gemini-flash-latest

# Server-only — wallet webhook HMAC verification (planned).
WEBHOOK_HMAC_SECRET=whsec_placeholder_only
