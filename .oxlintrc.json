{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "import",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "import/no-default-export": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "*.config.ts",
        "*.config.js",
        "*.config.mjs"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "src/app/**/*.ts",
        "src/app/**/*.tsx"
      ],
      "rules": {
        "import/no-default-export": "off",
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/components/ui/**/*.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/app/api/**/*.ts"
      ],
      "rules": {
        "no-console": [
          "error",
          {
            "allow": [
              "info",
              "warn",
              "error"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "workflows/**/*.mjs",
        "workflows/**/*.js"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".next"
  ]
}
